@startuml MH-HRM-03_HRM_Form
!theme materia

title Luồng Màn hình MH-HRM-03: Form Thêm/Sửa Nhân sự

start

if (Mode == Add?) then (Add)
  :Từ MH-HRM-01 (Click 'Thêm mới');
else (Edit)
  :Từ MH-HRM-02 (Click 'Sửa');
endif

partition MH-HRM-03 {
  if (Mode == Edit?) then (Edit)
   :Load dữ liệu Nhân viên hiện tại;
  endif
  :Hiển thị Form;
  ' Các trường thông tin: Cơ bản, Skills, Trạng thái, Phân bổ dự án...
  :Người dùng nhập/chỉnh sửa dữ liệu;

  split
    :Click nút 'Lưu';
    :Validate dữ liệu;
    if (Validation OK?) then (yes)
      :Lưu dữ liệu vào DB;
      if (Mode == Add?) then (Add)
        -> MH-HRM-01;
        end
      else (Edit)
        -> MH-HRM-02;
        end
      endif
    else (no)
      :Hiển thị lỗi Validation;
      -> MH-HRM-03;
      end
    endif

  split again
    :Click nút 'Hủy';
    if (Mode == Add?) then (Add)
      -> MH-HRM-01;
      end
    else (Edit)
      -> MH-HRM-02;
      end
    endif
  end split
}

stop
@enduml 